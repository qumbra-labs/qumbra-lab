#!/usr/bin/env bash
# The rig mutex. One heavy job at a time on this machine -- see CLAUDE.md section 5.
#
# Why a lock and not a convention: the convention was "check `ps`, then post a
# START line on issue #64". That is check-then-act, and the gap between the two
# is real -- issue #64 records two collisions from exactly that gap, one of them
# the coordinator's. On 2026-08-02 a measurement read 2.1x its true value because
# a suite started underneath it. `mkdir` is atomic; a `ps` snapshot is not.
#
#   scripts/rig run -- cargo test --release --workspace -- --test-threads=1
#   scripts/rig ps               # who is running, who is queued, recent history
#   scripts/rig log [-f]         # the current holder's log (tail; -f to follow)
#   scripts/rig status           # holder one-liner (kept stable for scripts)
#   scripts/rig release          # only if a trap failed to fire
#
# 2026-08-05 additions (Larry's ask: see progress, logs, running and queued):
#   - every `rig run` tees its output to $QUMBRA_RIG_LOGDIR (default
#     ~/develop/qumbra/logs) as rig-<UTC stamp>-<pid>.log and records the path
#     in the lock, so `rig log` and `rig ps` always find the live log;
#   - waiters register themselves in $LOCK.queue/ while they wait, so queueing
#     is visible instead of silent;
#   - every completion appends one TSV line to rig-manifest.tsv
#     (start, end, owner, rc, log, cmd) -- history is greppable.

# 2026-08-11 addition -- the gap the lock does NOT cover. The mutex serialises WHO
# RUNS. It says nothing about WHAT THEY RAN ON.
#
# The incident, corrected the same day and left here in full because the corrected
# version is the more useful lesson: a session edited
# crates/qumbra-explorer/src/json.rs in the shared main tree at 16:22, and another
# started the acceptance suite there at 16:24:28. ~~Two golden tests failed in a run
# whose owner had not touched that file.~~ **They did not.** The editing session
# reverted at 16:36:13, and cargo had not yet compiled qumbra-explorer -- the
# workspace's release build phase was still running twelve minutes in -- so that
# crate compiled from clean source and the run finished rc=0 with both goldens green
# (log rig-20260811T082413Z-81722.log:1653).
#
# It was a NEAR MISS decided by build-order timing, and the first account of it
# asserted the damage as fact without reading the log. Both halves matter here: the
# hazard is real -- had the edit still been in place when that crate compiled, the
# two goldens would have failed under someone else's name, and with no
# --no-fail-fast cargo stops at the first failing binary, so every crate after it
# would never have run -- and the reason nothing broke was luck, not design.
#
# The fix is provenance, not prohibition. Testing your own uncommitted work is the
# normal case and must stay frictionless -- so this does NOT block. It makes the tree
# state impossible to miss at start and impossible to lose afterwards: printed,
# written into the lock, prepended to the log, and carried in the manifest. A red
# result can then be attributed to a tree instead of argued about.
#
# It reads the tree of the DIRECTORY THE COMMAND WILL RUN IN, not "the repo": every
# worktree shares this one machine-global lock, and dirt in a sibling worktree cannot
# reach your run. That distinction is the whole reason worktrees are the convention.

set -uo pipefail

LOCK="${QUMBRA_RIG_LOCK:-$HOME/.qumbra-rig.lock}"
QUEUE="$LOCK.queue"
LOGDIR="${QUMBRA_RIG_LOGDIR:-$HOME/develop/qumbra/logs}"
MANIFEST="$LOGDIR/rig-manifest.tsv"
WHO="${QUMBRA_RIG_OWNER:-${MULTICA_ISSUE_ID:-$(whoami)@$(hostname -s)}}"

now() { date '+%Y-%m-%d %H:%M:%S %z'; }
stamp() { date -u '+%Y%m%dT%H%M%SZ'; }

# The tree this run will actually execute against. Degrades to `unknown` rather than
# failing: `rig run` is not only for git repos, and a provenance line must never be
# the reason a job does not start.
TREE_REV=""; TREE_DIRT=""; TREE_N=0
read_tree_state() {
  git rev-parse --git-dir >/dev/null 2>&1 || { TREE_REV="unknown (not a git tree)"; return; }
  TREE_REV="$(git rev-parse --short HEAD 2>/dev/null || echo unknown)"
  # --porcelain lists tracked modifications AND untracked files; untracked cannot
  # change a compiled binary, so they are counted separately and not alarmed on.
  TREE_DIRT="$(git status --porcelain --untracked-files=no 2>/dev/null)"
  [ -n "$TREE_DIRT" ] && TREE_N="$(printf '%s\n' "$TREE_DIRT" | wc -l | tr -d ' ')"
}

tree_banner() {
  if [ "$TREE_N" -eq 0 ]; then
    echo "rig: tree  $(pwd)  rev=$TREE_REV  CLEAN"
  else
    echo "rig: tree  $(pwd)  rev=$TREE_REV  🔴 DIRTY ($TREE_N tracked file(s) modified)"
    echo "rig:       this run's result belongs to THIS tree, not to $TREE_REV:"
    printf '%s\n' "$TREE_DIRT" | sed 's/^/rig:       /'
    echo "rig:       if you did not make these edits, someone else is working in this"
    echo "rig:       tree -- stop and use a worktree (CLAUDE.md, working conventions)."
  fi
}

holder_pid() { cat "$LOCK/pid" 2>/dev/null || echo ""; }

# A holder whose process is gone is not a holder. Without this one crashed baton
# wedges the rig until a human notices, which is worse than the race we fixed.
reap_if_stale() {
  local pid; pid="$(holder_pid)"
  [ -z "$pid" ] && return 1
  if kill -0 "$pid" 2>/dev/null; then return 1; fi
  echo "rig: holder pid $pid is gone -- breaking stale lock held by $(cat "$LOCK/owner" 2>/dev/null) since $(cat "$LOCK/started" 2>/dev/null)" >&2
  rm -rf "$LOCK"; return 0
}

# Same reaping for the queue: a waiter whose process died must not haunt `ps`.
reap_queue() {
  local f pid
  for f in "$QUEUE"/*.pid; do
    [ -e "$f" ] || continue
    pid="$(cat "$f" 2>/dev/null)"
    [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && continue
    rm -f "${f%.pid}".*
  done
}

status() {
  if [ -d "$LOCK" ]; then
    reap_if_stale && { echo "rig: FREE (stale lock reaped)"; return 0; }
    echo "rig: HELD by $(cat "$LOCK/owner" 2>/dev/null) pid $(holder_pid) since $(cat "$LOCK/started" 2>/dev/null)"
    echo "     cmd: $(cat "$LOCK/cmd" 2>/dev/null)"
    [ -f "$LOCK/logfile" ] && echo "     log: $(cat "$LOCK/logfile")"
    [ -f "$LOCK/tree" ] && echo "     tree: $(cat "$LOCK/tree")"
    return 1
  fi
  echo "rig: FREE"; return 0
}

ps_view() {
  status || true
  local n=0 f base
  if [ -d "$QUEUE" ]; then
    reap_queue
    for f in "$QUEUE"/*.owner; do
      [ -e "$f" ] || continue
      base="${f%.owner}"
      n=$((n + 1))
      echo "queued[$n]: $(cat "$f" 2>/dev/null) since $(cat "$base.since" 2>/dev/null) -- $(cat "$base.cmd" 2>/dev/null)"
    done
  fi
  [ "$n" -eq 0 ] && echo "queue: empty"
  if [ -f "$MANIFEST" ]; then
    echo "recent (rc | start -> end | owner | log | cmd):"
    tail -5 "$MANIFEST" | awk -F'\t' '{
      t = ($7 == "" ? "" : sprintf(" | rev=%s dirty=%s", $7, $8))
      printf "  rc=%s | %s -> %s | %s%s | %s | %s\n", $4, $1, $2, $3, t, $5, $6 }'
  fi
}

log_view() {
  if [ ! -d "$LOCK" ] || [ ! -f "$LOCK/logfile" ]; then
    echo "rig: nothing running -- see $MANIFEST for history" >&2; return 1
  fi
  local lf; lf="$(cat "$LOCK/logfile")"
  if [ "${1:-}" = "-f" ]; then exec tail -f "$lf"; else exec tail -40 "$lf"; fi
}

release() {
  rm -f "$QUEUE/$$".* 2>/dev/null
  if [ -d "$LOCK" ] && [ "$(holder_pid)" = "$$" ]; then
    rm -rf "$LOCK"; echo "rig: RELEASED by $WHO at $(now)" >&2
  fi
}

acquire() {
  local waited=0
  mkdir -p "$QUEUE"
  printf '%s\n' "$WHO"    > "$QUEUE/$$.owner"
  printf '%s\n' "$(now)"  > "$QUEUE/$$.since"
  printf '%s\n' "$*"      > "$QUEUE/$$.cmd"
  printf '%s\n' "$$"      > "$QUEUE/$$.pid"
  until mkdir "$LOCK" 2>/dev/null; do
    reap_if_stale && continue
    if [ "$waited" -eq 0 ] || [ $((waited % 300)) -eq 0 ]; then
      echo "rig: waiting for $(cat "$LOCK/owner" 2>/dev/null) (held ${waited}s so far) -- $(now)" >&2
    fi
    sleep 15; waited=$((waited + 15))
  done
  rm -f "$QUEUE/$$".*
  printf '%s\n' "$WHO"    > "$LOCK/owner"
  printf '%s\n' "$$"      > "$LOCK/pid"
  printf '%s\n' "$(now)"  > "$LOCK/started"
  printf '%s\n' "$*"      > "$LOCK/cmd"
  echo "rig: ACQUIRED by $WHO at $(now)${waited:+ (waited ${waited}s)}" >&2
}

case "${1:-status}" in
  status)  status ;;
  ps)      ps_view ;;
  log)     shift; log_view "${1:-}" ;;
  release) rm -rf "$LOCK"; echo "rig: lock removed by $WHO at $(now)" >&2 ;;
  run)
    shift; [ "${1:-}" = "--" ] && shift
    [ $# -eq 0 ] && { echo "usage: scripts/rig run -- <command>" >&2; exit 2; }
    mkdir -p "$LOGDIR"
    LOGFILE="$LOGDIR/rig-$(stamp)-$$.log"
    read_tree_state
    acquire "$*"
    printf '%s\n' "$LOGFILE" > "$LOCK/logfile"
    # In the lock so `rig status`/`ps` can answer "on what?", and at the head of the
    # log so the answer survives with the output it explains.
    printf 'rev=%s dirty=%s\n' "$TREE_REV" "$TREE_N" > "$LOCK/tree"
    { echo "rig: cwd $(pwd)"; tree_banner; } | tee "$LOGFILE" >&2
    trap release EXIT INT TERM
    START="$(now)"
    # tee passes stdout through unchanged, so callers that parse output keep
    # working; PIPESTATUS keeps the command's own exit code (bash-only, which
    # is why the shebang is bash and not sh).
    "$@" 2>&1 | tee "$LOGFILE"; rc=${PIPESTATUS[0]}
    # Appended at the END: `ps_view`'s awk reads $1..$6 positionally, and older lines
    # simply have no $7/$8 (awk yields empty, not an error).
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
      "$START" "$(now)" "$WHO" "$rc" "$LOGFILE" "$*" "$TREE_REV" "$TREE_N" >> "$MANIFEST"
    echo "rig: command exited $rc at $(now)" >&2
    exit $rc ;;
  *) echo "usage: scripts/rig {run -- <cmd>|ps|log [-f]|status|release}" >&2; exit 2 ;;
esac
